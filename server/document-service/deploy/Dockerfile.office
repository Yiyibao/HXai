# Deploy resolves BASE_IMAGE to an immutable digest; the image ID and package versions are recorded.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-math python3 python3-uno python3-pypdf \
    fonts-noto-cjk fonts-crosextra-carlito fonts-crosextra-caladea fonts-liberation2 fonts-dejavu-core fontconfig \
    && dpkg-query -W > /office-packages.txt && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY office_worker /app/office_worker
ENV HOME=/tmp LANG=C.UTF-8 PYTHONDONTWRITEBYTECODE=1 SAL_USE_VCLPLUGIN=svp
USER 65534:65534
ENTRYPOINT ["/usr/bin/python3", "-m", "office_worker.run"]
